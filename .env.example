# AI-MAP Ethiopia — docker compose configuration.
#
#   cp .env.example .env && nano .env
#
# docker compose reads .env from this directory automatically. It is gitignored:
# it holds two secrets and must never be committed.

# ---------------------------------------------------------------- required ---

# Protects the dashboard and every export endpoint. Anyone holding it can read
# the response data, so treat it as a password, not a setting.
#   openssl rand -hex 32
AIMAP_ADMIN_TOKEN=

# From @BotFather on Telegram — see "Setting up the Telegram bot" in DEPLOY.md.
# Leave EMPTY to run the web questionnaire and dashboard without the bot; the
# bot container will exit with an explanation rather than crash-loop silently.
AIMAP_BOT_TOKEN=

# ---------------------------------------------------------------- optional ---

# Where the server listens on the host. Inside the container it is always 8000.
# Bind to localhost and put a TLS proxy in front of it: this is plain HTTP, and
# the consent text promises respondents their answers travel securely.
AIMAP_BIND=127.0.0.1:8000

# Nightly backup retention, in days, for the `backup` profile.
AIMAP_BACKUP_KEEP=30
